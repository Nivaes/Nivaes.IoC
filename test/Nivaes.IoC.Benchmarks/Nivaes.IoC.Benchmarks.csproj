<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>

    <IsPackable>false</IsPackable>

    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <PackageReference Include="Grace" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="ZeroIoC" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\sources\Nivaes.IoC\Nivaes.IoC.csproj" />

    <ProjectReference Include="..\..\sources\Nivaes.IoC.SourceGenerator\Nivaes.IoC.SourceGenerator.csproj">
      <PrivateAssets>all</PrivateAssets>
      <OutputItemType>Analyzer</OutputItemType>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <ExcludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</ExcludeAssets>
    </ProjectReference>

  </ItemGroup>

</Project>
